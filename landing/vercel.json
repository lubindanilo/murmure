{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://188-245-2-239.sslip.io/:path*"
    }
  ],
  "headers": [
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/conditions",
      "destination": "/#conditions",
      "permanent": false
    },
    {
      "source": "/confidentialite",
      "destination": "/#confidentialite",
      "permanent": false
    },
    {
      "source": "/remboursement",
      "destination": "/#remboursement",
      "permanent": false
    },
    {
      "source": "/mentions-legales",
      "destination": "/#mentions-legales",
      "permanent": false
    }
  ]
}
